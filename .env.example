# Copy to .env and fill in. Never commit .env.

# Bind address and port inside the container (the host port is set in docker-compose.yml).
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Optional API keys, comma-separated. Restrict a key to accounts with "key:account1+account2".
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEYS=

# Optional: enable DNS-rebinding protection by listing the Host headers you expect, e.g. localhost:8770
MCP_ALLOWED_HOSTS=

ACCOUNTS_FILE=/config/accounts.yaml

# One password per account, referenced by password_env in accounts.yaml.
# Alternatively set MAIL_SUPPORT_PASSWORD_FILE=/run/secrets/... (Docker secrets).
MAIL_SUPPORT_PASSWORD=
MAIL_INFO_PASSWORD=

MAX_BODY_CHARS=20000
MAX_ATTACHMENT_MB=10
LOG_LEVEL=INFO
